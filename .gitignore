# Dependencies
node_modules/
Website/node_modules/

# Build outputs
dist/
Website/dist/

# Packaged desktop app (nativefier build)
StudyFlow-win32-x64/

# Release binaries (ZIP + installer exceed GitHub's 100 MB file limit) — they
# are hosted as GitHub Release assets instead. The tiny .sha256 checksums ARE
# committed (served same-origin so the app can fetch live hashes).
public/releases/*
!public/releases/*.sha256
installer/Output/

# Personal data backups (user study data — keep out of the repo)
studyflow-backup-*.json
studyspace-backup-*.json

# Personal identity documents (kept locally only — never commit)
src/Media/NIC.PNG
src/Media/NIC.pdf
src/Media/E-NIC.pdf
src/Media/Signature.png

# Personal logo (kept locally only — never commit)
src/Media/Logo.svg

# Logs
*.log
npm-debug.log*

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
